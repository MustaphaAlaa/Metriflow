{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Microsoft.EntityFrameworkCore": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": "Debug",
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/log-.txt",
          "rollingInterval": "Hour",
          "fileSizeLimitBytes":2097152,
          "rollOnFileSizeLimit": true
        }
      }
    ]
  },
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=6800;Database=metriflowdb;Username=postgres;Password=0000;SSL Mode=Prefer;"
  },
  "RabbitMQ": {
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "user",
    "Password": "mypassword",
    "Exchange": "analytics.raw",
    "Queues": {
      "IntervalAggregation": "metriflow.interval.aggregation",
      "DailyAggregation": "metriflow.daily.aggregation",
      "MonthlyAggregation": "metriflow.monthly.aggregation",
      "YearlyAggregation": "metriflow.yearly.aggregation",
      "AggregationCompleted": "metriflow.aggregation.completed",
      "AggregationFailed": "metriflow.aggregation.failed"
    }
  }
}
